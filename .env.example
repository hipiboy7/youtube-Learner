# youtubeLearner 환경별 설정 — 복사해서 .env 로 쓴다. .env 는 커밋하지 않는다 (CLAUDE.md 5절·11절).
# 값의 3분류: 여기 = 환경마다 다른 값 / constants.py = 설계 고정값 / backend/config/*.json = 실행마다 조절하는 값.
# 모든 키는 P0에서 한 번에 확정했다 (P0_요구사항정의서 FR-1). 이후 Phase는 키를 추가만 한다.

# ── 저장 위치 (scope-definition 4.3절·8.2절) ──
# DB·자막 원본·오디오 캐시·Whisper 원출력·모델 캐시의 루트. 개발은 ./data, 배포는 %LOCALAPPDATA%\youtubeLearner
DATA_DIR=./data
# 단계 실행 기록 status/<stage>_<run_id>.json (설계서_Architecture 6절)
STATUS_DIR=./status
# Whisper 모델 캐시. 비우면 DATA_DIR/models. C: 여유가 적고 Windows HF 캐시는 심볼릭 링크를 못 써 공간을 더 쓴다 (T-002)
HF_HOME=
# 설정 JSON 위치. 비우면 backend/config (패키지 위치에서 유도 — 작업 디렉토리에 의존하지 않는다)
CONFIG_DIR=

# ── 로깅 (설계서_Architecture 6절) ──
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# json = 한 줄 JSON(운영·사이드카) | text = 사람이 읽는 형식(개발)
LOG_FORMAT=json

# ── API 서버 (Phase 1~) ──
API_HOST=127.0.0.1
# 8000은 다른 도구와 자주 충돌해 피한다
API_PORT=8765
# 콤마 구분. P3 Vite dev 서버, P6 모바일 앱 출처를 여기에 추가 (설계서_Architecture 8.3절)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── YouTube 접근 (CLAUDE.md 8절, TechSpike 3.3절) ──
# yt-dlp JS 런타임. Node 24 확인됨. Deno 불필요
YTDLP_JS_RUNTIME=node
# PO 토큰 스크립트. 비우면 <저장소>\tools\bgutil-ytdlp-pot-provider\server\build\generate_once.js — 디스크 D: 우선 규칙(CLAUDE.md 7절), 홈 디렉토리(C:)에 두지 않는다.
# pip 패키지만으로는 안 된다 — README 최초 1회 절차대로 tools\ 에 clone 후 server/ 에서 npm ci && npx tsc (T-001)
BGUTIL_SCRIPT_PATH=
# HTTP 제공자(127.0.0.1:4416). 서버를 띄우지 않으면 경고가 반복되므로 기본 false
BGUTIL_HTTP_ENABLED=false

# ── 음성 인식 (scope-definition 5.3절) ──
# faster-whisper cpu_threads. 비우면 논리 코어 수(개발 VM = 2). 모델·VAD·beam은 backend/config/stt_default.json
STT_CPU_THREADS=

# ── 분석 슬롯 (scope-definition 2.4절, 보류 결정 1) ──
# 켤 분석기 이름(콤마 구분). v1은 비워 둔다 → NullAnalyzer 만. 이름을 넣으면 Phase 5 전까지는 기동 시 ConfigError
ANALYZERS=

# ── 환경 검사 (보류 결정 8) ──
# HF_HOME 드라이브 여유가 이 값(GB) 미만이면 check_env 가 WARN. P4 빌드 실측 후 갱신
DISK_FREE_WARN_GB=10
